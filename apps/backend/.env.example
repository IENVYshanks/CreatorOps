NODE_ENV=development
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://creator_ops:creator_ops@127.0.0.1:5432/creator_ops
APP_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=168
# disabled (default), mock (development only), or meta
INSTAGRAM_PROVIDER=disabled
# Required when INSTAGRAM_PROVIDER=meta
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/connections/instagram/callback
# INSTAGRAM_API_VERSION=v26.0
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# CONNECTION_TOKEN_ENCRYPTION_KEY=
# Optional if the ngrok executable is not available on PATH
# NGROK_BIN=ngrok
